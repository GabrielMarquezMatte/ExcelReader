<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A consumer's `dotnet publish -p:PublishAot=true -r <rid>` sets PublishAot as a global MSBuild
         property, which propagates to every project in the graph — including this one, reached only as
         an analyzer (ReferenceOutputAssembly=false in ExcelReader.Core.csproj). The SDK's own
         _RequiresILLinkPack (Microsoft.NET.Publish.targets) is set once and only if still empty
         ('$(_RequiresILLinkPack)' == ''), so fixing it to false here — an ordinary property, not a
         caller-supplied global, so a plain assignment sticks even where TreatAsLocalProperty does not —
         stops it from ever being computed true from PublishAot, which is what makes
         ProcessFrameworkReferences skip its AOT-target-framework check for this netstandard2.0 project
         instead of failing outright (NETSDK1207: AOT is not supported for netstandard2.0). -->
    <_RequiresILLinkPack>false</_RequiresILLinkPack>
    <!-- netstandard2.0, not 2.1: an analyzer/generator loads into the *compiler host* process, not the
         consumer's app. Visual Studio (devenv) and MSBuild.exe still run on .NET Framework 4.8, which
         cannot load a netstandard2.1 assembly at all — that consumer would silently get no generated
         code, with an error ("does not implement IExcelRowMap<T>") that gives no hint why. netstandard2.0
         loads everywhere: dotnet build, VS Code's Roslyn-on-.NET host, and classic devenv/MSBuild.exe. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Not distributed on its own; it ships inside ExcelReader.Core's nupkg (see the None Include
         in ExcelReader.Core.csproj) so consumers get it just by referencing the main package. -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- No PublicAPI.txt: an IIncrementalGenerator is never consumed as an ordinary library API — its
       only public surface is the [Generator] attribute the SDK discovers via reflection. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);RS0016;RS0026;RS0037;HLQ012</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
