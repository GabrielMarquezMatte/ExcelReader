<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Ship XML docs and enforce documentation for every public API member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <PackageId>ExcelReader.NET</PackageId>
    <Version>1.0.0</Version>
    <Authors>Gabriel Matte</Authors>
    <Title>ExcelReader</Title>
    <Description>High-performance, low-allocation .NET library for reading and writing XLSX, XLSB, XLS, and CSV — streaming readers, typed row parsing, and workbook writers for all four formats.</Description>
    <PackageTags>excel;xlsx;xlsb;xls;csv;reader;writer;parser;spreadsheet;streaming;performance;low-allocation</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/GabrielMarquezMatte/ExcelReader</PackageProjectUrl>
    <RepositoryUrl>https://github.com/GabrielMarquezMatte/ExcelReader</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>See the changelog: https://github.com/GabrielMarquezMatte/ExcelReader/releases</PackageReleaseNotes>
    <Copyright>Copyright (c) Gabriel Matte</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Binary parsers (BIFF12 framing, etc.) are internal but warrant isolated unit tests. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ExcelReader.Tests" />
    <!-- NativeApi.Schema.cs / NativeApi.Typed.cs drive SchemaInference directly, so the C ABI and
         Excel.InferSchema answer identically by construction rather than by two parallel copies. -->
    <InternalsVisibleTo Include="ExcelReader.Native" />
  </ItemGroup>

  <!-- The source generator runs as an analyzer during this project's own build (and any consumer's),
       never as an ordinary dependency — ReferenceOutputAssembly=false keeps its assembly out of this
       project's own references. -->
  <ItemGroup>
    <ProjectReference Include="..\ExcelReader.Generator\ExcelReader.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Packs the generator's DLL into this package's analyzers folder so a consumer gets it just by
       referencing ExcelReader.NET — release.yml only packs this project, not the generator separately.
       A hardcoded bin/ path like this is fragile to configuration/TFM drift, so verify it actually
       landed in the nupkg with a real `dotnet pack` + unzip after touching this. -->
  <ItemGroup>
    <None Include="..\ExcelReader.Generator\bin\$(Configuration)\netstandard2.0\ExcelReader.Generator.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <!-- Public API surface differs per TFM (RefParser/NamedRefRowEnumerable/ExcelRowContext are
       #if NET9_0_OR_GREATER only), so each target framework tracks its own Shipped/Unshipped
       files instead of sharing the root-level ones the analyzer picks up by convention. -->
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI\$(TargetFramework)\PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI\$(TargetFramework)\PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
