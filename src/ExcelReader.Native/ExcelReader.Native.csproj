<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <!-- Publishing this project with -r <rid> produces the C-ABI shared library
         (ExcelReader.Native.dll/.so/.dylib). Ordinary `dotnet build` still produces a normal
         managed assembly, which is what ExcelReader.Tests references. -->
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- Keeps ICU out of the shared library; this layer does no culture-sensitive formatting. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Speed</OptimizationPreference>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <StackTraceSupport>false</StackTraceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <!-- Deliberately NOT set. This binary is a redistributable: CI builds it in one job and runs it
         in another (different runner VM), and release.yml ships it inside the PyPI wheel and as a
         GitHub release asset. `IlcInstructionSet=native` resolves against the *build host's* CPU and
         bakes those features in as a hard requirement, so the NativeAOT startup check aborts the
         process — "The required instruction sets are not supported by the current CPU.", not a
         catchable error — on any CPU missing them. GitHub's hosted pool mixes Intel and AMD hosts,
         which made that an intermittent all-tests-abort in the cpp/rust/python jobs and a wheel that
         could crash at import on a user's machine. ILC's default baseline is host-independent, and
         Core's vector paths are guarded by Vector128/256.IsHardwareAccelerated, which stay runtime
         checks under AOT — so they still light up on capable CPUs without pinning anything here.
         If a floor is ever wanted, pin a fixed one (x86-64-v2/v3) — never `native`. -->
    <!-- RS0016/RS0026/RS0037: public-API tracking is for ExcelReader.Core's shipped NuGet surface.
         This project is never packed — its C ABI is tracked by include/excelreader.h instead. -->
    <!-- CA1031: every exported function is a hard boundary. An escaping exception would
         corrupt the caller's stack, so catch-all plus a status code is the required behavior. -->
    <!-- CA2000: file streams handed to Excel.From*(leaveOpen: false) are owned and disposed by the
         reader — the same ownership-transfer pattern used across the tests. -->
    <NoWarn>$(NoWarn);RS0016;RS0026;RS0037;CA1031;CA2000</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebuggerSupport>false</DebuggerSupport>
  </PropertyGroup>

  <!-- The stripped macOS/arm64 dylib SIGSEGVs intermittently in a host that links it (the Rust
       aggregate tests), after a multi-threaded xl_csv_aggregate_* run; the unstripped one does not. -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('osx'))">
    <StripSymbols>false</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExcelReader.Core\ExcelReader.Core.csproj" />
    <ProjectReference Include="..\ExcelReader.Generator\ExcelReader.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The span-based NativeApi is the tested surface; [UnmanagedCallersOnly] exports cannot be
       invoked from managed code, so the tests drive the layer underneath them. The benchmarks are
       here for the same reason: measuring xl_parse_typed means calling NativeApi.ParseTyped. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ExcelReader.Tests" />
    <InternalsVisibleTo Include="ExcelReader.Benchmarks" />
  </ItemGroup>

</Project>
