<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <!-- Publishing this project with -r <rid> produces the C-ABI shared library
         (ExcelReader.Native.dll/.so/.dylib). Ordinary `dotnet build` still produces a normal
         managed assembly, which is what ExcelReader.Tests references. -->
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- Keeps ICU out of the shared library; this layer does no culture-sensitive formatting. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Speed</OptimizationPreference>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <StackTraceSupport>false</StackTraceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <!-- x64 floor is a fixed x86-64-v3 (AVX2, Haswell/Excavator and newer), never `native`. This
         binary is a redistributable: CI builds it in one job and runs it in another (different
         runner VM), and release.yml ships it inside the PyPI wheel and as a GitHub release asset.
         `native` resolves against the *build host's* CPU and bakes those features in as a hard
         requirement, so the NativeAOT startup check aborts the process — "The required instruction
         sets are not supported by the current CPU.", not a catchable error — on any CPU missing them.
         GitHub's hosted pool mixes Intel and AMD hosts, which made that an intermittent
         all-tests-abort in the cpp/rust/python jobs. A fixed level is host-independent. It is pinned
         because ILC's default x64 baseline has no runtime dispatch: Vector256.IsHardwareAccelerated and
         Avx2.IsSupported both compile to false under it, so Core's 256-bit paths (the CSV structural
         scanner) and the BCL's ran their 128-bit fallbacks. v3 measured 3-6% faster across xl_parse_typed
         and xl_next_row(_view) on XLSX/XLSB/CSV (the CSV reader alone ~15%).
         The same startup abort now hits pre-AVX2 x64 CPUs. arm64 keeps ILC's default baseline
         (AdvSimd, which Core's Vector128 paths use; apple-m1 on osx-arm64). -->
    <IlcInstructionSet Condition="$(RuntimeIdentifier.EndsWith('-x64'))">x86-64-v3</IlcInstructionSet>
    <!-- RS0016/RS0026/RS0037: public-API tracking is for ExcelReader.Core's shipped NuGet surface.
         This project is never packed — its C ABI is tracked by include/excelreader.h instead. -->
    <!-- CA1031: every exported function is a hard boundary. An escaping exception would
         corrupt the caller's stack, so catch-all plus a status code is the required behavior. -->
    <!-- CA2000: file streams handed to Excel.From*(leaveOpen: false) are owned and disposed by the
         reader — the same ownership-transfer pattern used across the tests. -->
    <NoWarn>$(NoWarn);RS0016;RS0026;RS0037;CA1031;CA2000</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebuggerSupport>false</DebuggerSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExcelReader.Core\ExcelReader.Core.csproj" />
    <ProjectReference Include="..\ExcelReader.Generator\ExcelReader.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Static PGO profile for NativeAOT: without it the AOT library runs up to ~1.26x slower than the
       same code under the JIT's dynamic PGO. Regenerate it after changing a hot path; see README.md. -->
  <ItemGroup>
    <MibcFile Include="pgo\excelreader.mibc" />
  </ItemGroup>

  <!-- The span-based *Api classes are the tested surface; [UnmanagedCallersOnly] exports cannot be
       invoked from managed code, so the tests drive the layer underneath them. The benchmarks are
       here for the same reason: measuring xl_parse_typed means calling TypedApi.ParseTyped. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ExcelReader.Tests" />
    <InternalsVisibleTo Include="ExcelReader.Benchmarks" />
    <InternalsVisibleTo Include="ExcelReader.NativePgoTrainer" />
  </ItemGroup>

</Project>
