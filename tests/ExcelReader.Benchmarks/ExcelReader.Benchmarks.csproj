<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Benchmark host app: ConfigureAwait is irrelevant (no captured sync context). -->
    <!-- CA1707: BenchmarkDotNet method names use underscores (e.g. Xlsx_ExcelReader) for readable
         report output — that's the tool's own naming convention, not a target for cleanup. -->
    <!-- CA1849/VSTHRD103/S6966: several benchmarks deliberately call the sync API because that's
         the code path being measured. -->
    <!-- IDISP001: sheet/row writers created here are owned and disposed by their parent
         workbook writer, same pattern as the ownership-transfer suppressions in Core. -->
    <NoWarn>$(NoWarn);CA2007;MA0004;CA1707;CA1849;VSTHRD103;S6966;IDISP001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ExcelReader.Core\ExcelReader.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="MiniExcel" Version="*" />
    <PackageReference Include="Sep" Version="0.15.1" />
    <PackageReference Include="SpreadCheetah" Version="1.28.0" />
    <PackageReference Include="Sylvan.Data" Version="0.2.17" />
    <PackageReference Include="Sylvan.Data.Csv" Version="1.4.4" />
    <PackageReference Include="Sylvan.Data.Excel" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Data\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
