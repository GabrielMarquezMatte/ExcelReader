<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Benchmark host app: ConfigureAwait is irrelevant (no captured sync context). -->
    <NoWarn>$(NoWarn);CA2007;MA0004</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ExcelReader.Core\ExcelReader.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="MiniExcel" Version="*" />
    <PackageReference Include="Sep" Version="0.15.0" />
    <PackageReference Include="SpreadCheetah" Version="1.27.0" />
    <PackageReference Include="Sylvan.Data" Version="0.2.17" />
    <PackageReference Include="Sylvan.Data.Csv" Version="1.4.4" />
    <PackageReference Include="Sylvan.Data.Excel" Version="*" />
  </ItemGroup>

</Project>
