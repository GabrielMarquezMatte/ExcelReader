<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RootNamespace>ExcelReader.Tests</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- CA2007: ConfigureAwait is not needed in test code (no captured sync context). -->
    <!-- CA1849: tests deliberately exercise the sync reader/dispose paths;
         "use the async overload" is noise here. Core keeps this rule active. -->
    <!-- CA1707: xUnit test names use underscores (Should_X_When_Y) for readability. -->
    <NoWarn>$(NoWarn);CA2007;CA1849;CA1707;MA0004</NoWarn>
    <NoWarn>$(NoWarn);CA2000;CA1034;CA1812;CA1835;CA1034;MA0060;CA2022</NoWarn>
    <!-- RS0016/RS0026/RS0037: the public-API-tracking analyzer is for ExcelReader.Core's shipped
         NuGet surface. This is a test project — its public test classes/methods are an xUnit
         convention, not an API commitment, so there's no PublicAPI.txt here by design. -->
    <NoWarn>$(NoWarn);RS0016;RS0026;RS0037</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="data\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Ground-truth XLSB produced by Excel itself; the native FFI tests open it by path. -->
    <Content Include="..\..\RealExcel.xlsb" Link="data\RealExcel.xlsb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.0" />
    <!-- Drives ExcelRowMapGenerator directly (CSharpGeneratorDriver over an in-memory Compilation) in
         GeneratorTests.cs, instead of relying on the live build-time analyzer pipeline — a deliberately
         broken test model (e.g. missing 'partial', for the EXR001 test) would otherwise fail this
         project's own compilation. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Apache.Arrow" Version="23.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ExcelReader.Cli\ExcelReader.Cli.csproj" />
    <ProjectReference Include="..\..\src\ExcelReader.Core\ExcelReader.Core.csproj" />
    <ProjectReference Include="..\..\src\ExcelReader.Arrow\ExcelReader.Arrow.csproj" />
    <ProjectReference Include="..\..\src\ExcelReader.Native\ExcelReader.Native.csproj" />
    <!-- OutputItemType="Analyzer" makes the generator actually run over this project's own compilation
         (so a [ExcelSerializable] model declared here gets real generated code, exercised by
         GeneratedMapParityTests.cs) — without it, only the assembly reference existed, and the
         generator ran solely through GeneratorTests.cs's in-memory CSharpGeneratorDriver harness. -->
    <ProjectReference Include="..\..\src\ExcelReader.Generator\ExcelReader.Generator.csproj" OutputItemType="Analyzer" />
  </ItemGroup>

</Project>
