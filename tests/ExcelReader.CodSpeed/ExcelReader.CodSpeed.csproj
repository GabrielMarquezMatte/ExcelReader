<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- CA1303: the harness writes plain diagnostics to stdout; it is a CI tool, not a
         localized application, so literal strings are intentional.
         CA2007/MA0004: no synchronization context in a console host, ConfigureAwait is noise.
         CA1849/VSTHRD103/S6966: several scenarios deliberately measure the sync API.
         IDISP001: sheet/row writers are owned and disposed by their parent workbook writer,
         same ownership-transfer pattern the benchmark project suppresses.
         CA1815: the struct model only exists to exercise the parser's no-allocation path; it is
         never compared for equality.
         RS0016/RS0026/RS0037: public-API tracking is for ExcelReader.Core's shipped NuGet
         surface; this app is never packaged, so there is no PublicAPI.txt here by design. -->
    <NoWarn>$(NoWarn);CA1303;CA2007;MA0004;CA1849;VSTHRD103;S6966;IDISP001;CA1815;RS0016;RS0026;RS0037</NoWarn>

    <!-- CodSpeed times the whole process, so any run-to-run jitter in the CLR itself (not the
         benchmarked code) leaks straight into the numbers. Tiered compilation promotes hot
         methods on a background timer, and concurrent/server GC run on their own threads: both
         are scheduled by the OS, so their timing varies with host noise, not with the workload.
         Fixing all three removes that source of variance. -->
    <TieredCompilation>false</TieredCompilation>
    <TieredPGO>false</TieredPGO>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ExcelReader.Core\ExcelReader.Core.csproj" />
  </ItemGroup>

  <!-- The real-world 65K-row fixtures live with the BenchmarkDotNet project; link them here
       instead of committing a second 36 MB copy. -->
  <ItemGroup>
    <None Include="..\ExcelReader.Benchmarks\Data\**" Link="Data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
